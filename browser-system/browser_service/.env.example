# Browser service configuration — copy to .env and adjust
# (Docker: docker run --env-file .env ...)

# --- service ---
BROWSER_SERVICE_HOST=127.0.0.1
BROWSER_SERVICE_PORT=8080
# Optional shared secret the Node app must send as X-API-Key header.
# Leave empty to disable (only do this on a trusted local network).
BROWSER_SERVICE_API_KEY=

# --- browser behaviour ---
BROWSER_HEADLESS=true            # false = visible browser (needs a display)
BROWSER_SLOW_MO_MS=0             # e.g. 100 for human-like pacing when headful
BROWSER_TIMEOUT_MS=30000         # default per-action timeout
BROWSER_NAV_TIMEOUT_MS=45000     # navigation timeout
BROWSER_MAX_TABS=5               # max tabs per task
BROWSER_MAX_TASKS=20             # max concurrent tasks
BROWSER_TASK_IDLE_TTL_SEC=1800   # evict tasks idle longer than this

# --- proxy (Germany routing etc.) ---
# The Germany subagent verifies these. Format: http://host:port  or
# http://user:pass@host:port  (or set BROWSER_PROXY_USERNAME/PASSWORD).
BROWSER_HTTP_PROXY=
BROWSER_HTTPS_PROXY=
BROWSER_PROXY_USERNAME=
BROWSER_PROXY_PASSWORD=

# --- downloads ---
BROWSER_DOWNLOAD_DIR=./downloads
BROWSER_MAX_DOWNLOAD_MB=100

# --- politeness / safety ---
BROWSER_RESPECT_ROBOTS=true
BROWSER_MIN_REQUEST_INTERVAL_MS=1500
BROWSER_USER_AGENT=
BROWSER_BLOCKED_HOSTS=           # comma-separated, e.g. "internal.corp,10.0.0.5"

# --- screenshots ---
BROWSER_SCREENSHOT_MAX_KB=2048

# --- research history (SQLite, optional) ---
BROWSER_ENABLE_HISTORY=false
BROWSER_HISTORY_DB=./history.db
