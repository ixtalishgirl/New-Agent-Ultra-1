# =====================================================================
# WireGuard CLIENT config TEMPLATE — Germany tunnel for browser traffic
# =====================================================================
# !! TEMPLATE ONLY — replace EVERY placeholder before use. !!
# !! Never commit a filled-in copy. Never paste keys into chat. !!
#
# This config is meant for ahsan's OWN VPS located in Germany
# (e.g. Frankfurt or Nuremberg region). The VPS is the SERVER side;
# this file is the CLIENT side (the machine running the browser service).
#
# Flow:
#   1. Rent/prepare a VPS in Germany (his decision — see GERMANY.md).
#   2. Install WireGuard on the VPS, generate server keypair, enable IP
#      forwarding, add iptables/nftables NAT masquerade (instructions below).
#   3. Generate a client keypair locally, fill this template, copy to
#      /etc/wireguard/wg-germany.conf on the browser machine (root-only perms).
#   4. wg-quick up wg-germany  -> browser traffic exits via the German VPS.
#   5. Run ../../verify_german_ip.py to confirm the egress IP is German.

[Interface]
# Client private key — generate with:  wg genkey | tee client.key | wg pubkey > client.pub
# Paste the PRIVATE key here (client.key contents).
PrivateKey = <CLIENT_PRIVATE_KEY_BASE64>

# Client tunnel address. Must match the address the VPS server assigned
# to this client (inside the tunnel subnet, e.g. 10.8.0.2/24).
Address = <CLIENT_TUNNEL_IPv4>/24
# Address = <CLIENT_TUNNEL_IPv6>/64   # uncomment if the server assigns IPv6

# DNS pushed through the tunnel — keeps DNS consistent with the German exit.
# Use the VPS's own resolver or a resolver you trust.
DNS = <GERMAN_DNS_IPv4>, <GERMAN_DNS_IPv6>

[Peer]
# VPS server public key (server.pub contents from the German VPS).
PublicKey = <SERVER_PUBLIC_KEY_BASE64>

# The VPS's public endpoint. Must be a German IP/hostname.
# Example shape (placeholder — use YOUR VPS's real address):
Endpoint = <VPS_PUBLIC_IP_OR_HOSTNAME>:51820

# Route ALL browser-machine traffic through the tunnel:
#   0.0.0.0/0  = all IPv4
#   ::/0       = all IPv6
# If you only want SOME traffic tunneled (split tunnel), narrow this to
# the browser service's destinations instead. Full tunnel is the default
# because "Germany option" means "appears German everywhere".
AllowedIPs = 0.0.0.0/0, ::/0

# Keep the tunnel alive through NAT (home routers, mobile networks).
PersistentKeepalive = 25
