# =====================================================================
# Germany Web-Access Option — example environment configuration
# =====================================================================
# Copy to .env.germany (real file — never commit it, never share it)
# and fill in values you got from YOUR OWN VPS / proxy provider.
#
# The browser service reads these variables at startup.
# Empty/unset values = route through Germany is DISABLED (normal direct
# routing). There is no fallback magic: no values, no German egress.

# --- Proxy URLs -----------------------------------------------------
# Format examples:
#   http://user:pass@proxy-host.example.com:8080
#   https://user:pass@proxy-host.example.com:8443
#   socks5://user:pass@proxy-host.example.com:1080
#   socks5h://user:pass@proxy-host.example.com:1080   (DNS through proxy)
#
# IMPORTANT:
# * The proxy endpoint itself must be hosted IN Germany (your VPS in a
#   German datacenter, e.g. Frankfurt/Nuremberg, or a commercial German
#   proxy/VPN provider). The URL alone doesn't make traffic "German" —
#   the EXIT NODE's location does.
# * socks5h is preferred over socks5: it resolves DNS through the
#   proxy, which avoids leaking your real DNS resolver's location.
# * Never paste the real filled-in file into chat or screenshots.

BROWSER_HTTP_PROXY=
BROWSER_HTTPS_PROXY=
# Optional: proxy for all other outbound traffic from the agent process
ALL_PROXY=

# --- DNS (leak prevention) ------------------------------------------
# Used only with a WireGuard/tunnel setup. If you route via proxy only,
# prefer socks5h above instead of touching these.
#
# A German DNS resolver keeps reverse/PTR answers and DNS-based
# geolocation consistent with the German exit IP.
# Examples: a German VPS running its own resolver, or a privacy DNS you
# trust (Quad9 9.9.9.9 is Swiss-based; Cloudflare 1.1.1.1 is anycast).
GERMAN_DNS_PRIMARY=
GERMAN_DNS_SECONDARY=

# --- WireGuard tunnel (alternative to proxy) ------------------------
# Path to the client config generated from config/wireguard/wg-germany.conf.example
# Leave empty if you are using a proxy instead of WireGuard.
WIREGUARD_CONFIG_PATH=

# --- Verification targets -------------------------------------------
# Base URL of the browser service whose egress IP should be verified.
# The verify script checks the BROWSER's egress (via this status endpoint),
# not just the backend machine's own IP.
# Example: http://localhost:8000   (the browser service's /status route)
BROWSER_SERVICE_STATUS_URL=

# --- Behavior -------------------------------------------------------
# What to do when a site demands more than an IP (residency proof,
# local phone number, German account verification, KYC):
#   report   = surface the requirement to ahsan honestly, do NOT fake it
# Options are deliberately limited. There is no "fake it" option.
ON_VERIFICATION_DEMAND=report

# Expected country code for the PASS/FAIL verdict.
EXPECTED_COUNTRY_CODE=DE
