# Copy to .env (never commit real keys). The pipeline works without any of
# these — it then runs in "vision unavailable — text-only" fallback mode.

# Which adapter to use (see adapters/). Currently: openai_compat (+ aliases
# vllm / ollama / openai-compatible). Leave empty for text-only fallback.
VISION_ADAPTER=

# OpenAI-compatible vision endpoint (vLLM, Ollama, LocalAI, llama.cpp...).
# Examples:
#   Ollama locally:        http://localhost:11434/v1/chat/completions
#   vLLM on Kaggle tunnel: http://<tunnel-host>/v1/chat/completions
VISION_MODEL_URL=

# Model id the server exposes, e.g. qwen2.5vl:7b (Ollama) or
# Qwen/Qwen2.5-VL-7B-Instruct (vLLM).
VISION_MODEL_NAME=

# Optional bearer token. Local servers (Ollama/vLLM) usually ignore it.
VISION_MODEL_KEY=

# HTTP timeout (s) and max description tokens.
VISION_TIMEOUT=60
VISION_MAX_TOKENS=512
